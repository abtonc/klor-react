{
  "name": "@klor/react",
  "version": "0.3.0",
  "description": "Remote config, feature flags, and update gating for React and React Native.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./devtools": {
      "types": "./dist/devtools/index.d.ts",
      "default": "./dist/devtools/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "prepublishOnly": "rm -rf dist && pnpm build && pnpm test"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "react": "^19.3.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  },
  "homepage": "https://klor.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abtonc/klor-react.git"
  },
  "bugs": {
    "url": "https://github.com/abtonc/klor-react/issues",
    "email": "support@klor.dev"
  },
  "keywords": [
    "feature-flags",
    "remote-config",
    "feature-toggle",
    "react",
    "react-native",
    "ab-testing",
    "rollout",
    "force-update",
    "version-gate",
    "klor"
  ],
  "publishConfig": {
    "access": "public"
  }
}
