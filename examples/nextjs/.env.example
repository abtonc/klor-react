# Copy to .env.local. Keys come from the API keys page of a Klor project.
# The secret key is read only on the server; never prefix it with NEXT_PUBLIC_.
KLOR_SECRET_KEY=klor_sec_...
NEXT_PUBLIC_KLOR_PUBLIC_KEY=klor_pub_...

# Optional. Defaults to https://edge.klor.dev.
KLOR_BASE_URL=
NEXT_PUBLIC_KLOR_BASE_URL=
